# Runtime image for the fully-GPU-resident OGameSim training loop on AMD ROCm.
#
# Base = AMD's official PyTorch+ROCm image (torch with HIP preinstalled). We only layer the RL
# libraries on top, with torch protected by a pip constraint so it is never replaced.
#
# Build:
#   podman build -t ogamesim-gpu -f Containerfile .
# Run (with GPU passthrough):
#   ./run-container.sh ogamesim-gpu
#
# Pinning: ':latest' is convenient but some users hit intermittent gfx1100 (7900 XTX) hangs on it
# (CONCEPT.md §10). If validation step 3 stalls, pin a known-good tag via BASE_IMAGE, e.g.:
#   podman build --build-arg BASE_IMAGE=rocm/pytorch:rocm6.2.4_ubuntu22.04_py3.10_pytorch_release_2.3.0 \
#                -t ogamesim-gpu -f Containerfile .
# Browse tags: https://hub.docker.com/r/rocm/pytorch/tags
ARG BASE_IMAGE=rocm/pytorch:latest
FROM ${BASE_IMAGE}

WORKDIR /opt/ogamesim
COPY requirements.txt .

# Derive a constraint that pins torch to the EXACT build already in the image, then install the RL
# libs under it. This lets pip resolve torchrl/tensordict + their deps while making it impossible
# to swap out the ROCm torch. The final assert fails the build loudly if the HIP backend is lost.
RUN python -m pip install --no-cache-dir --upgrade pip \
 && pip show torch | grep ^Version: | tr -d ' ' | sed s/Version:/torch==/ > /tmp/torch-constraint.txt \
 && echo "torch pin: $(cat /tmp/torch-constraint.txt)" \
 && python -m pip install --no-cache-dir -c /tmp/torch-constraint.txt -r requirements.txt \
 && python -c "import torch; assert torch.version.hip, 'torch lost its ROCm/HIP backend — see requirements.txt'; print('ROCm torch OK:', torch.__version__, 'hip', torch.version.hip)"

WORKDIR /workspace
CMD ["/bin/bash"]
